# Port on which the Baileys server will listen
PORT=3000

# --- Email Notification Configuration ---
# The email to which alerts will be sent
EMAIL_NOTIFY_TO=your-support-email@domain.com

# SMTP server configuration (example with Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sending-email@gmail.com
SMTP_PASS=your-application-password

# --- Dashboard login (public/index.html) ---
# Required to access the dashboard UI. Does NOT protect /api/sessions or
# /api/meta, which remain open as before.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me
# Random secret used to sign the session cookie (e.g. `openssl rand -hex 32`)
SESSION_SECRET=change-me-too